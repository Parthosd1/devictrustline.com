# Copy to api/.env for local development (never commit the real file). Load it with: set -a; . ./.env; set +a
DATABASE_URL=postgres://devicetrustline:devicetrustline@localhost:5432/devicetrustline
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
# Browser origins allowed to call the API with a session cookie (comma separated).
APP_ORIGIN=http://localhost:5173
# Allow anyone to create a new workspace. Defaults to false in production.
ALLOW_SIGNUP=true
SESSION_HOURS=8
# Set to true when running behind a reverse proxy or load balancer.
TRUST_PROXY=false
# Set to true on extra API instances to skip the audit scheduler (safe either way)
DISABLE_SCHEDULER=false
# Managed Postgres that requires TLS: true (verify certificate) or no-verify.
DATABASE_SSL=
DATABASE_POOL_SIZE=10
# Serve the built web app from this directory (set automatically in the production Docker image).
STATIC_DIR=
# One JSON line per request. Defaults to true in production.
LOG_REQUESTS=
# Public address of the web app, used in links in emails and notifications.
APP_URL=http://localhost:5173
# production turns on secure cookies, request logs and stricter checks.
APP_ENV=
# Sign-in, sign-up and password-reset attempts allowed per address per window.
AUTH_RATE_LIMIT=20
# Where uploaded files are stored (receipts, photos, manuals).
ATTACHMENTS_DIR=./data/attachments
MAX_UPLOAD_MB=10

# Email. Leave SMTP_URL empty to send nothing (the app shows invitation links to copy instead).
# MAIL_MODE=capture keeps mail in the database for local testing and is refused in production.
SMTP_URL=
MAIL_FROM=DeviceTrustline <no-reply@devicetrustline.com>
MAIL_MODE=
# Defaults to true when SMTP_URL is set.
REQUIRE_EMAIL_VERIFICATION=

# Google sign-in. Redirect URI: <APP_URL>/api/auth/google/callback. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser push. Generate once with: cargo run -- vapid-keys. Leave empty to turn push off.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:support@devicetrustline.com

# Text messages: disabled (default), log (development: written to the server log) or twilio.
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
