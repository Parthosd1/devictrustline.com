# Copy to deploy/.env and fill in. Never commit the real file.
DOMAIN=devicetrustline.com
# Generate each with: openssl rand -base64 48
JWT_SECRET=
POSTGRES_PASSWORD=
# Leave false; create your first admin with the create-admin command (see docs/DEPLOYMENT.md).
ALLOW_SIGNUP=false
SESSION_HOURS=8
BACKUP_KEEP_DAYS=14

# Email (invitations, confirmations, password resets, reminders). Leave SMTP_URL empty to send
# nothing; the app then shows invitation links to copy and never claims an email was sent.
# Format: smtps://USER:PASSWORD@smtp.example.com:465  or  smtp://USER:PASSWORD@smtp.example.com:587?tls=required
# (URL-encode special characters in the password).
SMTP_URL=
MAIL_FROM=DeviceTrustline <no-reply@devicetrustline.com>
# Defaults to true when SMTP_URL is set.
REQUIRE_EMAIL_VERIFICATION=
# Google sign-in. Authorized redirect URI in Google Cloud: https://DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAX_UPLOAD_MB=10
