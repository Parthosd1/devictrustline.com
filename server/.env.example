# Copy to server/.env for local development (never commit the real file).
DATABASE_URL=postgres://devicetrustline:devicetrustline@localhost:5432/devicetrustline
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
# Browser origins allowed to call the API with a session cookie (comma separated).
APP_ORIGIN=http://localhost:5173
# Allow anyone to create a new workspace. Defaults to false in production.
ALLOW_SIGNUP=true
SESSION_HOURS=8
# Set to true when running behind a reverse proxy or load balancer.
TRUST_PROXY=false
